MINIO_ACCESS_KEY="your-access-key"
MINIO_SECRET_KEY="your-secret-key"
NEXT_PUBLIC_BUCKET_HOST="minio.example.com" # Public URL for assets

# Email (Resend)
RESEND_API_KEY="re_..."
ADMIN_EMAIL="admin@example.com"

# App URLs
FRONTEND_URL="http://localhost:3000"


