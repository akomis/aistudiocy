# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/fos"

# Payload CMS
PAYLOAD_SECRET="generate-a-secure-random-string"

# Stripe
STRIPE_API_KEY="sk_test_..." # Secret key (server-side only)
NEXT_PUBLIC_STRIPE_KEY="pk_test_..." # Publishable key (client-side)

# MinIO / S3 Storage
MINIO_ENDPOINT="https://minio.example.com"
