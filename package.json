{
  "name": "fos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "=20"
  },
  "type": "module",
  "scripts": {
    "dev": "FRONTEND_URL=http://localhost:3000 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "load-env": "railway login && railway link --project af60ba60-9d5f-4da4-bb99-416334c3b312 -s 9f60a70f-2189-4574-b8cf-03e6d644caab --environment d1b49053-bc52-45c0-802f-bf6e1b5bcf2e && railway shell",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:fresh": "payload migrate:fresh",
    "stripe:test": "stripe listen --forward-to localhost:3000/api/stripe/webhooks",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npx tsc --noEmit",
    "pre-push": "yarn build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,scss}": "prettier --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@payloadcms/db-postgres": "^3.67.0",
    "@payloadcms/email-resend": "^3.67.0",
    "@payloadcms/next": "^3.67.0",
    "@payloadcms/plugin-stripe": "3.68.1",
    "@payloadcms/richtext-lexical": "^3.67.0",
    "@payloadcms/storage-s3": "^3.67.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.4",
    "@react-email/components": "^0.0.31",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^5.2.0",
    "@tanstack/react-query": "^5.61.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.9.0",
    "lucide-react": "^0.464.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.3",
    "payload": "^3.67.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-photo-album": "^3.0.2",
    "recharts": "^3.5.1",
    "resend": "^4.0.0",
    "sharp": "^0.33.5",
    "stripe": "^17.4.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.1",
    "yet-another-react-lightbox": "^3.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8",
    "prettier": "^3.7.4",
    "react-email": "^3.0.4",
    "sass": "^1.94.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
