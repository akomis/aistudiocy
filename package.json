{
  "name": "fos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "=22"
  },
  "type": "module",
  "scripts": {
    "dev": "FRONTEND_URL=http://localhost:3000 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "load-env": "railway login && railway link --project af60ba60-9d5f-4da4-bb99-416334c3b312 -s 9f60a70f-2189-4574-b8cf-03e6d644caab --environment d1b49053-bc52-45c0-802f-bf6e1b5bcf2e && railway shell",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:fresh": "payload migrate:fresh",
    "stripe:test": "stripe listen --forward-to localhost:3000/api/stripe/webhooks",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx tsc --noEmit",
    "pre-push": "npx lint-staged && yarn build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,scss}": "prettier --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/third-parties": "^16.0.8",
    "@payloadcms/db-postgres": "^3.68.2",
    "@payloadcms/email-resend": "^3.68.2",
    "@payloadcms/next": "^3.68.2",
    "@payloadcms/plugin-stripe": "^3",
    "@payloadcms/richtext-lexical": "^3.68.2",
    "@payloadcms/storage-s3": "^3.68.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-email/components": "^1.0.1",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.5.3",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.12.0",
    "lucide-react": "^0.560.0",
    "next": "^15",
    "next-themes": "^0.4.6",
    "payload": "^3.68.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.68.0",
    "react-photo-album": "^3.3.0",
    "recharts": "^3.5.1",
    "resend": "^6.6.0",
    "sharp": "^0.34.5",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "yet-another-react-lightbox": "^3.27.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react-email": "^5.0.7",
    "sass": "^1.96.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3",
    "typescript": "^5.9.3"
  }
}
